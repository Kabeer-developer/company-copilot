# Copy these values into your ignored .env file.
# Copy to .env and replace every placeholder locally. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=company_knowledge_copilot
JWT_SECRET_KEY=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
VECTOR_SEARCH_INDEX_NAME=chunk_vector_index
RETRIEVAL_TOP_K=5
RETRIEVAL_CONTEXT_MAX_CHARS=12000
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
CONVERSATION_HISTORY_LIMIT=10
